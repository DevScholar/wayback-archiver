{
  "name": "wacz-archiver",
  "version": "2.0.0",
  "description": "Read WACZ web archives: export to standalone HTML and serve for replay",
  "private": true,
  "scripts": {
    "download": "tsx src/downloader.ts",
    "export": "tsx src/export-to-html.ts",
